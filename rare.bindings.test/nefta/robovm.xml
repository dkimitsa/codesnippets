<config>
    <executableName>${app.executable}</executableName>
    <mainClass>${app.mainclass}</mainClass>
    <os>ios</os>    
    <target>ios</target>
    <iosInfoPList>Info.plist.xml</iosInfoPList>
    <frameworkPaths>
        <path>../libs/nefta</path>
    </frameworkPaths>

    <tools>
        <linker>
            <flags>
                <flag>-ld_classic</flag>  <!-- Quick fix for Xcode15 -->
            </flags>
        </linker>
    </tools>

    <swiftSupport>
        <copySwiftLibs>false</copySwiftLibs>
    </swiftSupport>
</config>